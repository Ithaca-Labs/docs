{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "openx402",
  "description": "Build and operate x402 payments on Stellar with openx402.",
  "colors": {
    "primary": "#704E00",
    "light": "#FFD21C",
    "dark": "#8A6500"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "family": "Archivo"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "background": {
    "decoration": "grid"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "banner": {
    "content": "Testnet preview: Stellar `exact` is live; `upto` remains proposed and pubnet is gated. [Review release status](/operations/security#pubnet).",
    "dismissible": true,
    "type": "warning"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Build",
        "pages": [
          "guides/http-seller",
          "guides/seller-sdk",
          "guides/buyer-client",
          "guides/embedded-facilitator",
          "guides/mcp"
        ]
      },
      {
        "group": "Discover",
        "pages": [
          "concepts/bazaar",
          "concepts/catalog-lifecycle",
          "concepts/search",
          "concepts/evaluation",
          "concepts/evaluation-workflow"
        ]
      },
      {
        "group": "Protocol",
        "pages": [
          "concepts/exact"
        ]
      },
      {
        "group": "Upto (proposed)",
        "pages": [
          "guides/upto",
          "concepts/upto",
          "concepts/smart-accounts",
          "reference/upto-conformance"
        ]
      },
      {
        "group": "Operate",
        "pages": [
          "operations/self-hosting",
          "operations/security",
          "operations/troubleshooting"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/api",
          "reference/analytics",
          "reference/configuration",
          "reference/mcp-tools",
          "reference/sdk-surface",
          "reference/storage",
          "reference/cli"
        ]
      }
        ]
      },
      {
        "tab": "Architecture",
        "groups": [
          {
            "group": "Architecture",
            "pages": [
              "architecture/overview"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "openapi": "openapi.json"
      },
      {
        "tab": "SDK",
        "groups": [
          {
            "group": "Integrate",
            "pages": [
              "guides/seller-sdk",
              "guides/buyer-client",
              "guides/mcp"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "reference/sdk-surface",
              "reference/mcp-tools"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/Ithaca-Labs/openx402",
          "icon": "github"
        },
        {
          "anchor": "Bazaar SDK",
          "href": "https://www.npmjs.com/package/@openx402/bazaar-sdk",
          "icon": "package"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/Ithaca-Labs/openx402"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Start building",
      "href": "/quickstart"
    }
  },
  "search": {
    "prompt": "Search openx402 docs..."
  },
  "api": {
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": ["curl", "javascript", "python"],
      "defaults": "required"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "cursor",
      "vscode"
    ],
    "display": "header"
  },
  "metadata": {
    "timestamp": true
  },
  "interaction": {
    "drilldown": false
  },
  "seo": {
    "indexing": "navigable"
  },
  "errors": {
    "404": {
      "redirect": false,
      "title": "Page not found",
      "description": "This openx402 documentation page does not exist."
    }
  },
  "redirects": [
    {
      "source": "/docs/GETTING_STARTED",
      "destination": "/quickstart",
      "permanent": true
    },
    {
      "source": "/docs/SELLER_GUIDE",
      "destination": "/guides/http-seller",
      "permanent": true
    },
    {
      "source": "/docs/BUYER_CLIENT",
      "destination": "/guides/buyer-client",
      "permanent": true
    },
    {
      "source": "/docs/MCP",
      "destination": "/guides/mcp",
      "permanent": true
    },
    {
      "source": "/docs/BAZAAR",
      "destination": "/concepts/bazaar",
      "permanent": true
    },
    {
      "source": "/docs/ARCHITECTURE",
      "destination": "/architecture/overview",
      "permanent": true
    },
    {
      "source": "/docs/SELF_HOSTING",
      "destination": "/operations/self-hosting",
      "permanent": true
    },
    {
      "source": "/docs/SECURITY",
      "destination": "/operations/security",
      "permanent": true
    },
    {
      "source": "/docs/TROUBLESHOOTING",
      "destination": "/operations/troubleshooting",
      "permanent": true
    }
  ],
  "footer": {
    "socials": {
      "github": "https://github.com/Ithaca-Labs/openx402"
    }
  }
}
